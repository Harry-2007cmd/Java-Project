# Copy this file to db.properties (same folder) and put your own MySQL details in it.
# db.properties is git-ignored, so your password never gets committed.
# Any value can also be set with the DB_URL / DB_USER / DB_PASSWORD environment variables.

db.url=jdbc:mysql://localhost:3306/campus_parking?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
db.user=root
db.password=your_password
